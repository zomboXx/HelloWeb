<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">
    <persistence-unit name="email-list-jpa" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.example.email.model.User</class>
        <properties>
            <property name="hibernate.connection.provider_class"
                      value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider" />
            <property name="hibernate.hikari.driverClassName" value="org.h2.Driver" />
            <property name="hibernate.hikari.jdbcUrl"
                      value="jdbc:h2:mem:email_list_jpa;MODE=MySQL;NON_KEYWORDS=USER;DB_CLOSE_DELAY=-1" />
            <property name="hibernate.hikari.username" value="sa" />
            <property name="hibernate.hikari.password" value="" />
            <property name="hibernate.hikari.maximumPoolSize" value="5" />
            <property name="hibernate.hikari.minimumIdle" value="1" />
            <property name="hibernate.hikari.poolName" value="email-list-jpa-pool" />
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create" />
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
        </properties>
    </persistence-unit>
</persistence>
